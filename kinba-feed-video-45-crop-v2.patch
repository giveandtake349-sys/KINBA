From 1875e339a4a20fe8b8f9ad01062bc5c4996d125f Mon Sep 17 00:00:00 2001
From: Mr X <mrx@local>
Date: Thu, 15 Oct 2026 21:36:42 +0300
Subject: [PATCH] feat(feed): Facebook-style 4:5 crop for tall videos

---
 .../kinba/client/src/components/MediaHub.tsx  | 30 +++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/artifacts/kinba/client/src/components/MediaHub.tsx b/artifacts/kinba/client/src/components/MediaHub.tsx
index 1c026d8..86edb8c 100644
--- a/artifacts/kinba/client/src/components/MediaHub.tsx
+++ b/artifacts/kinba/client/src/components/MediaHub.tsx
@@ -1344,6 +1344,9 @@ function InlineVideoPlayer({
   const [displayDims, setDisplayDims] = useState<{ w: number; h: number } | null>(null);
   const displayW = displayDims?.w ?? w;
   const displayH = displayDims?.h ?? h;
+  // Facebook-style: videos taller than 4:5 get cropped to 4:5 in feed.
+  // Tap opens the fullscreen viewer showing the full video.
+  const isTallCrop = displayH / displayW > 1.25;
 
   const [isNearViewport, setIsNearViewport] = useState(false);
   useEffect(() => {
@@ -1468,7 +1471,7 @@ function InlineVideoPlayer({
       style={{
         position: "relative",
         width: "100%",
-        aspectRatio: `${displayW} / ${displayH}`,
+        aspectRatio: isTallCrop ? "4 / 5" : `${displayW} / ${displayH}`,
         background: "var(--page-bg)",
         overflow: "hidden",
         borderRadius: 0,
@@ -1499,10 +1502,33 @@ function InlineVideoPlayer({
           display: "block",
           width: "100%",
           height: "100%",
-          objectFit: "contain",
+          objectFit: isTallCrop ? "cover" : "contain",
+          objectPosition: "center",
           background: "var(--page-bg)",
         }}
       />
+      {isTallCrop && (
+        <span
+          aria-hidden="true"
+          style={{
+            position: "absolute",
+            right: 8,
+            bottom: 8,
+            width: 30,
+            height: 30,
+            borderRadius: "50%",
+            background: "rgba(0,0,0,0.55)",
+            display: "flex",
+            alignItems: "center",
+            justifyContent: "center",
+            pointerEvents: "none",
+          }}
+        >
+          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
+            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
+          </svg>
+        </span>
+      )}
       <button
         type="button"
         aria-label={muted ? "Unmute video" : "Mute video"}
-- 
2.43.0

