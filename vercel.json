{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir artifacts/kinba build:vercel",
  "outputDirectory": "artifacts/kinba/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kinba.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
