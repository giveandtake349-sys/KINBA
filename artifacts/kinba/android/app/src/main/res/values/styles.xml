<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Native launch splash: this theme derived from Theme.SplashScreen and
         showed @drawable/splash, a KINBA screen in front of the JHILIK opening
         video. Per the Capacitor SplashScreen docs, changing the parent to
         AppTheme.NoActionBar disables the splash-screen compatibility layer.
         The window now uses the JHILIK splash colour instead, and on Android
         12+ the system splash is forced to that same colour with no icon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#050505</item>
        <item name="android:windowSplashScreenBackground">#050505</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
    </style>
</resources>